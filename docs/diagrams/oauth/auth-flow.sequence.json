  "cards": [
    {
      "dot": "emerald",
      "title": "OAuth + PKCE Connection",
      "items": [
        "The organization authenticates the user and issues an authorization code",
        "The platform exchanges the code for tokens using the PKCE code_verifier",
        "The platform calls GET /merchants for the store picker and business profile",
        "The access_token (JWT) authenticates every subsequent call"
      ]
    },
    {
      "dot": "rose",
      "title": "JWT Authorization",
      "items": [
        "Every MCP call validates signature, iss, aud, and exp",
        "The MCP calls GET /userinfo on the organization's authorization server to get the user's authorization context",
        "list_merchants is a recommended fallback tool; connect already loaded stores via GET /merchants"
      ]
    },
    {
      "dot": "orange",
      "title": "Data Access",
      "items": [
        "DataBridge runs queries filtered by authorized merchant_ids",
        "The MCP never queries merchants outside the subject's scope",
        "The platform returns the response to the user"
      ]
    }
  ]
